  "decisions": {
    "architectureDecisions": [
      {
        "id": "ADR-001",
        "title": "Usar Domain-Driven Design (DDD)",
        "status": "ACCEPTED",
        "component": "project-structure",
        "rationale": "Separación clara entre dominio y persistencia",
        "consequences": "Mayor mantenibilidad, testabilidad y flexibilidad"
      },
      {
        "id": "ADR-002",
        "title": "Usar MapStruct para Entity Mapping",
        "status": "ACCEPTED",
        "component": "entity-mapping",
        "rationale": "Type-safe, mejor performance que ModelMapper",
        "consequences": "Menos runtime overhead, mejor verificación en compilación"
      },
      {
        "id": "ADR-003",
        "title": "Spring Data JPA + MySQL",
        "status": "ACCEPTED",
        "component": "persistence",
        "rationale": "Stack moderno y ampliamente soportado",
        "consequences": "Facilita CRUD, relaciones, pero lock-in con Spring"
      },
      {
        "id": "ADR-004",
        "title": "REST API con OpenAPI Documentation",
        "status": "ACCEPTED",
        "component": "api",
        "rationale": "Documentación automática y client generation",
        "consequences": "APIs autodocumentadas, mejor developer experience"
      }
    ]
  },
